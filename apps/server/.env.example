APP_ENV=development
PORT=8080

DATABASE_URL=postgres://identitycard:identitycard@localhost:5432/identitycard?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# better-auth's JWKS endpoint (apps/web) — every bearer token this API
# receives gets verified against it. Fetched once at boot and kept fresh
# in the background (internal/pkg/jwt), not re-fetched per request.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

WEB_ORIGIN=http://localhost:3000

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=identitycard
S3_USE_SSL=false

# signs ID-card QR tokens — unrelated to auth, see internal/pkg/qrtoken
QR_SECRET=dev-only-change-me-too

# defaults point at the Mailhog container in infra/docker-compose.yml —
# sent mail shows up at http://localhost:8025, nothing leaves the machine
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@identitycard.local

# used by `make seed` (cmd/seed) only — writes directly into better-auth's
# tables (no password, the app is passwordless); the seeded account signs
# in for real via the email-code tab in apps/web, delivered to Mailhog
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ORG_NAME=Acme Events
SEED_ORG_SLUG=acme-events
