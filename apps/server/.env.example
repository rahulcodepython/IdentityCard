APP_ENV=development
PORT=8080

DATABASE_URL=postgres://identitycard:identitycard@localhost:5432/identitycard?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

WEB_ORIGIN=http://localhost:3000

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=identitycard
S3_USE_SSL=false

# signs ID-card QR tokens — separate from JWT_SECRET on purpose, see
# internal/qrtoken
QR_SECRET=dev-only-change-me-too

# defaults point at the Mailhog container in infra/docker-compose.yml —
# sent mail shows up at http://localhost:8025, nothing leaves the machine
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@identitycard.local

# used by `make seed` (cmd/seed) only
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Super Admin
SEED_ORG_NAME=Acme Events
SEED_ORG_SLUG=acme-events
